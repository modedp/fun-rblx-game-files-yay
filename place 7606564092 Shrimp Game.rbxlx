        local v12 = p4.Turret.YawLower.Value
        local v13 = math.rad(v12)
        local v14 = p4.Turret.YawUpper.Value
        local v15 = math.rad(v14)
        v11.DesiredAngle = math.clamp(v10, v13, v15)
        if p6 then
            p4.YawMotor:SetAngle(v10)
        end
        local v16 = (p4.YawMotor.Part0.CFrame * p4.YawMotor.C0 * CFrame.Angles(0, 0, p4.YawMotor.DesiredAngle) * p4.YawMotor.C1:Inverse() * p4.PitchMotor.C0):PointToObjectSpace(p5)
        local v17 = -v16.X
        local v18 = v16.Y
        local v19 = math.atan2(v17, v18)
        local v20 = p4.PitchMotor
        local v21 = p4.Turret.PitchLower.Value
        local v22 = math.rad(v21)
        local v23 = p4.Turret.PitchUpper.Value
        local v24 = math.rad(v23)
        v20.DesiredAngle = math.clamp(v19, v22, v24)
        if p6 then
            p4.PitchMotor:SetAngle(v19)
